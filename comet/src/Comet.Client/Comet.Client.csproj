<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shared with Unity: netstandard2.1 and C# 9 until Unity 7 (CoreCLR, .NET 10). -->
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>9</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Comet.Protocol\Comet.Protocol.csproj" />
  </ItemGroup>

  <!-- The Login client's JSON. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
