<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ShapeLand.uss" />
    <ui:VisualElement name="join" class="backdrop hidden">
        <ui:VisualElement name="card-safe" class="card-safe" picking-mode="Ignore">
            <ui:VisualElement class="card">
                <ui:Label text="#join.title" class="title join-title" />
                <ui:VisualElement class="look-head">
                    <ui:Button name="look-back" class="menu-back" focusable="false">
                        <ui:VisualElement class="menu-back-arrow" picking-mode="Ignore" />
                        <ui:Label text="#menu.back" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Label text="#menu.change_look" class="menu-page-name" />
                </ui:VisualElement>
                <!-- The card's own pages, with Back: signing in, and setting a password from the signed-in card. -->
                <ui:VisualElement class="page-head">
                    <ui:Button name="page-back" class="menu-back" focusable="false">
                        <ui:VisualElement class="menu-back-arrow" picking-mode="Ignore" />
                        <ui:Label text="#menu.back" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Label name="page-name" class="menu-page-name" />
                </ui:VisualElement>
                <ui:VisualElement name="sign-in" class="card-page">
                    <ui:VisualElement name="sign-in-username-field" class="field">
                        <ui:Label text="#account.username_label" class="label" />
                        <ui:TextField name="sign-in-username" max-length="16" class="input" />
                    </ui:VisualElement>
                    <ui:VisualElement name="sign-in-password-field" class="field">
                        <ui:Label text="#account.password_label" class="label" />
                        <ui:TextField name="sign-in-password" password="true" max-length="128" class="input" />
                    </ui:VisualElement>
                    <ui:VisualElement name="sign-in-code-field" class="field hidden">
                        <ui:Label text="#account.code_label" class="label" />
                        <ui:TextField name="sign-in-code" max-length="40" class="input code-input" />
                        <ui:Label text="#account.code_sign_in_note" class="card-note" />
                    </ui:VisualElement>
                    <ui:Button name="sign-in-use-code" class="link-button" />
                </ui:VisualElement>
                <ui:VisualElement name="set-password" class="card-page">
                    <ui:VisualElement class="field">
                        <ui:Label text="#account.username_label" class="label" />
                        <ui:Label name="set-password-username" class="input-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="field">
                        <ui:Label text="#account.new_password_label" class="label" />
                        <ui:TextField name="set-password-field" password="true" max-length="128" class="input" />
                    </ui:VisualElement>
                    <ui:VisualElement class="field">
                        <ui:Label text="#account.confirm_password_label" class="label" />
                        <ui:TextField name="set-password-again" password="true" max-length="128" class="input" />
                    </ui:VisualElement>
                    <ui:Label text="#account.password_rules" class="card-note" />
                </ui:VisualElement>
                <ui:ScrollView name="card-scroll" class="card-scroll menu-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
                    <ui:VisualElement class="body">
                        <ui:VisualElement name="player-fields" class="fields">
                            <ui:VisualElement name="name-row" class="field nav-row">
                                <ui:VisualElement class="label-row">
                                    <ui:Label text="#join.name_label" class="label" />
                                </ui:VisualElement>
                                <ui:TextField name="name" max-length="16" class="input" />
                            </ui:VisualElement>
                            <ui:VisualElement class="field nav-row">
                                <ui:Label text="#join.shape_label" class="label" />
                                <ui:VisualElement name="shapes" class="row" />
                            </ui:VisualElement>
                            <ui:VisualElement class="field nav-row">
                                <ui:Label text="#join.color_label" class="label" />
                                <ui:VisualElement name="colors" class="row swatches" />
                            </ui:VisualElement>
                            <ui:VisualElement class="field nav-row">
                                <ui:Label text="#join.eyes_label" class="label" />
                                <ui:VisualElement name="eyes" class="row swatches" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <!-- A signed-in player who isn't playing: who they are, beside their shape. -->
                        <ui:VisualElement name="who" class="who">
                            <ui:Label text="#account.signed_in_as" class="label" />
                            <ui:Label name="who-name" class="who-name" />
                            <ui:Label name="who-guest" text="#account.guest" class="guest-tag" />
                            <ui:Label name="who-guest-note" text="#account.guest_card_note" class="card-note" />
                        </ui:VisualElement>
                        <ui:VisualElement class="preview-column">
                            <ui:VisualElement name="preview" class="preview" />
                            <ui:VisualElement name="stats" class="stats" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
                <ui:Label name="error" class="error" />
                <ui:VisualElement class="actions">
                    <ui:VisualElement name="have-account" class="have-account">
                        <ui:Label text="#account.have_account" class="have-account-text" />
                        <ui:Button name="sign-in-button" text="#account.sign_in" class="cancel-button" />
                    </ui:VisualElement>
                    <ui:Button name="sign-out-button" text="#account.sign_out" class="sign-out-button" />
                    <ui:VisualElement class="spacer" />
                    <ui:Button name="cancel-button" text="#join.cancel" class="cancel-button hidden" />
                    <ui:Button name="join-button" text="#join.play" class="join-button" />
                </ui:VisualElement>
                <!-- Desktop builds: the Login server, a quiet line under the buttons; Change opens the field. -->
                <ui:VisualElement name="server-line" class="server-line">
                    <ui:Label name="server-text" class="server-text" />
                    <ui:Button name="server-change" text="#join.server_change" class="link-button" />
                    <ui:VisualElement name="server-field" class="field server nav-row hidden">
                        <ui:VisualElement class="label-row">
                            <ui:Label text="#join.server_label" class="label" />
                        </ui:VisualElement>
                        <ui:TextField name="server" class="input" />
                    </ui:VisualElement>
                    <ui:Button name="server-cancel" text="#join.cancel" class="link-button server-cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="card-prompts" class="menu-prompts" picking-mode="Ignore">
            <ui:VisualElement class="prompt keys-part">
                <ui:Label text="#menu.key_enter" class="key" />
                <ui:Label text="#menu.select" />
            </ui:VisualElement>
            <ui:VisualElement class="prompt keys-part changing-only">
                <ui:Label text="#menu.key_esc" class="key" />
                <ui:Label text="#menu.back" />
            </ui:VisualElement>
            <ui:VisualElement class="prompt pad-part">
                <ui:VisualElement class="glyph icon-pad-south" />
                <ui:Label text="#menu.select" />
            </ui:VisualElement>
            <ui:VisualElement class="prompt pad-part changing-only">
                <ui:VisualElement class="glyph icon-pad-east" />
                <ui:Label text="#menu.back" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <!-- Joining a returning player (on launch, and after a server restart): a small pop-up over the world. -->
    <ui:VisualElement name="join-pop" class="join-pop hidden">
        <ui:VisualElement name="pop-dots" class="pop-dots">
            <ui:VisualElement class="pop-dot" />
            <ui:VisualElement class="pop-dot" />
            <ui:VisualElement class="pop-dot" />
        </ui:VisualElement>
        <ui:Label text="!" class="pop-fail-mark" />
        <ui:VisualElement class="pop-text">
            <ui:Label name="pop-main" class="pop-main" />
            <ui:Label name="pop-sub" class="pop-sub" />
        </ui:VisualElement>
        <ui:Button name="pop-cancel" text="#account.cancel" class="cancel-button pop-button" />
        <ui:Button name="pop-retry" text="#account.retry" class="join-button pop-button pop-retry" />
    </ui:VisualElement>
</ui:UXML>
