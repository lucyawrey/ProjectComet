/*
 * ShapeLand's UI in the plain look: dark see-through panels, one blue accent, Atkinson Hyperlegible. Ported from
 * the approved mockup. Laid out at 960 x 600; the panel scales with the screen.
 * USS has no text-transform, so upper-case labels are written in capitals.
 */

.hidden { display: none; }

.backdrop {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(10, 16, 30, 0.32);
    align-items: center; justify-content: center;
    -unity-font: url("Fonts/AtkinsonHyperlegible-Regular.ttf");
    font-size: 15px;
    color: rgb(238, 241, 246);
}
.backdrop.hidden, .backdrop.waiting { display: none; }
/* Changing the look in game: the game dims and the HUD fades as behind the Esc menu, the card has a page header
   (Back only when opened from the menu) in place of the title, and the HUD around it stays usable. */
.backdrop.changing { background-color: rgba(8, 12, 22, 0.55); }
.look-head { display: none; flex-direction: row; align-items: center; margin-bottom: 12px; }
.backdrop.changing .look-head { display: flex; }
.backdrop.changing .join-title { display: none; }

/* The card has the Esc menu window's size, place and look (.menu-window), growing only for an error; on a phone its
   height is its content's, to fit. */
.card {
    position: absolute; left: 50%; top: 50%; translate: -50% -54%;
    width: 600px; min-height: 440px;
    padding: 18px 24px 16px 24px;
    background-color: rgba(16, 20, 28, 0.96);
    border-width: 2px; border-color: rgba(238, 241, 246, 0.16); border-radius: 8px;
}
.backdrop.phone .card { min-height: 0; }
.card > .body { flex-grow: 1; }
/* Rows a gamepad or the arrow keys move through (JoinScreen), the selected one tinted like a Settings row. */
.card .nav-row { margin: -4px -8px 6px -8px; padding: 4px 8px; border-radius: 4px; }
.card .nav-row.server { margin-bottom: -4px; }
/* The selection shows only while keys or a gamepad move it (.navigating, set by JoinScreen and GameMenu). */
.backdrop.navigating .nav-row.selected { background-color: rgba(106, 161, 255, 0.2); }
.join-button, .cancel-button { border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.backdrop.navigating .join-button.selected, .backdrop.navigating .cancel-button.selected { border-color: rgb(255, 255, 255); }

Label { padding: 0; margin: 0; }
.title { font-size: 28px; margin-bottom: 8px; -unity-font: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); }
.body { flex-direction: row; }
.fields { flex-grow: 1; }
.field { margin-bottom: 10px; }
.label-row { flex-direction: row; align-items: flex-end; margin-bottom: 5px; }
.label { font-size: 12px; letter-spacing: 1px; color: rgb(169, 178, 196); }
.field > .label { margin-bottom: 5px; }

.input { margin: 0; }
/* Centered by padding, not a fixed height: Unity draws an empty field's caret at the top of the text box. */
.input .unity-base-text-field__input {
    padding: 8px 10px; margin: 0;
    -unity-text-align: upper-left;
    --unity-cursor-color: rgb(238, 241, 246);
    --unity-selection-color: rgba(106, 161, 255, 0.45);
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.16); border-radius: 4px;
    color: rgb(238, 241, 246); font-size: 15px;
    -unity-font: url("Fonts/AtkinsonHyperlegible-Regular.ttf");
}
/* One line of the font (Atkinson Hyperlegible's 1.24 at 15px), so an empty field is as tall as a filled one: on the
   Linux desktop build an empty field was a different height from a filled one. */
.input .unity-text-element { height: 19px; }
.input:focus .unity-base-text-field__input { border-color: rgb(106, 161, 255); }

.row { flex-direction: row; flex-wrap: wrap; }

.shape-button {
    flex-direction: row; align-items: center;
    height: 34px; padding: 0 10px 0 6px; margin: 0 6px 0 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px; border-color: rgba(255, 255, 255, 0.16); border-radius: 4px;
    color: rgb(238, 241, 246); font-size: 14px;
}
.shape-button:hover { background-color: rgba(255, 255, 255, 0.06); }
.shape-button.on { border-color: rgb(106, 161, 255); background-color: rgba(106, 161, 255, 0.18); }
.shape-icon { width: 26px; height: 26px; margin-right: 4px; }

.swatch {
    width: 26px; height: 26px; padding: 0; margin: 0 6px 4px 0;
    border-width: 2px; border-color: rgba(0, 0, 0, 0); border-radius: 3px;
}
.swatch.on { border-color: rgb(255, 255, 255); }

.preview-column { width: 150px; margin-left: 18px; align-items: center; justify-content: center; }
.preview { width: 128px; height: 128px; margin-bottom: 10px; }
.stats { width: 150px; }
.stat { margin-bottom: 7px; }
.stat-top { flex-direction: row; justify-content: space-between; margin-bottom: 3px; }
.stat-top > Label { font-size: 13px; }
.stat-name { color: rgb(169, 178, 196); }
.bar { height: 6px; background-color: rgba(255, 255, 255, 0.12); border-radius: 3px; }
.bar-fill { height: 6px; background-color: rgb(106, 161, 255); border-radius: 3px; transition-property: width; transition-duration: 0.25s; }

.error {
    display: none;
    padding: 7px 10px; margin-bottom: 10px;
    background-color: rgba(229, 57, 53, 0.18);
    border-left-width: 3px; border-color: rgb(255, 107, 103);
    color: rgb(255, 212, 211); font-size: 14px; white-space: normal;
}
.error.shown { display: flex; }

.actions { flex-direction: row; align-items: flex-end; }
.server { width: 300px; margin-bottom: 0; }
.spacer { flex-grow: 1; }
.join-button {
    height: 40px; padding: 0 26px; margin: 0;
    background-color: rgb(61, 124, 240);
    border-radius: 4px;
    color: rgb(255, 255, 255); font-size: 16px;
    -unity-font: url("Fonts/AtkinsonHyperlegible-Bold.ttf");
}
.join-button:hover { background-color: rgb(83, 141, 247); }
.cancel-button {
    height: 40px; padding: 0 20px; margin: 0 10px 0 0;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    color: rgb(238, 241, 246); font-size: 16px;
}
.cancel-button:hover { background-color: rgba(255, 255, 255, 0.16); }
.cancel-button.hidden { display: none; }

/* ---- In game: chat, name tags and speech bubbles ---- */

.hud {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    -unity-font: url("Fonts/AtkinsonHyperlegible-Regular.ttf");
    font-size: 15px;
    color: rgb(238, 241, 246);
}
.hud.hidden { display: none; }
.tags { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* The chat box fades in code (Chat), not with USS transitions. */
.chat { position: absolute; left: 16px; bottom: 16px; width: 380px; }
.chat-log { max-height: 190px; padding: 8px 10px; background-color: rgba(18, 22, 30, 0.7); border-radius: 6px; }
.chat-log.empty { display: none; }
/* The log's scroll bar: a thin rounded track and thumb like the stat bars, with no arrow buttons. */
.chat-log .unity-scroller--vertical { width: 6px; margin-left: 6px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.chat-log .unity-scroller__low-button, .chat-log .unity-scroller__high-button { display: none; }
.chat-log .unity-scroller__slider { width: 6px; min-width: 6px; margin: 0; padding: 0; flex-grow: 1; }
.chat-log .unity-base-slider__tracker {
    left: 0; right: 0; top: 0; bottom: 0; width: auto; margin: 0;
    border-width: 0; border-radius: 3px; background-color: rgba(255, 255, 255, 0.12);
}
.chat-log .unity-base-slider__dragger {
    left: 0; width: 6px; margin: 0;
    border-width: 0; border-radius: 3px; background-color: rgba(255, 255, 255, 0.35);
}
.chat-log .unity-base-slider__dragger:hover { background-color: rgb(106, 161, 255); }
.chat-log .unity-base-slider__dragger-border { display: none; }
.chat-line { flex-direction: row; align-items: flex-start; margin-bottom: 3px; }
.chat-line .shape-icon { width: 14px; height: 14px; margin-right: 5px; margin-top: 3px; flex-shrink: 0; }
.chat-name { font-size: 14px; margin-right: 6px; flex-shrink: 0; -unity-font: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); }
.chat-text { font-size: 14px; flex-shrink: 1; white-space: normal; }
.chat-note { font-size: 14px; color: rgb(169, 178, 196); white-space: normal; }

.chat-input-row {
    margin-top: 6px; padding-right: 10px;
    flex-direction: row; align-items: center;
    background-color: rgba(18, 22, 30, 0.9);
    border-width: 1px; border-color: rgb(61, 124, 240); border-radius: 4px;
}
.chat-input-row.hidden { display: none; }
.chat-input { flex-grow: 1; }
.chat-input .unity-base-text-field__input { background-color: rgba(0, 0, 0, 0); border-width: 0; font-size: 14px; }
.chat-keys { font-size: 12px; color: rgb(141, 151, 171); }
/* With touch controls in use (.touch-input, set by TouchControls), Send stands in for the keys note: an on-screen
   keyboard may have no Enter for the game to see. */
.chat-send {
    display: none;
    margin: 4px 0; padding: 4px 12px; font-size: 14px; -unity-font-style: bold;
    background-color: rgb(61, 124, 240); border-width: 0; border-radius: 3px;
    color: rgb(238, 241, 246);
}
.hud.touch-input .chat-keys { display: none; }
.hud.touch-input .chat-send { display: flex; }

/* Change Look, Return to Spawn, chat and network stats as round buttons at the top left, larger with touch controls
   in use. With a mouse, hovering one shows its name and key. Icons from UI/Icons (see its README). */
.hud-row { position: absolute; left: 16px; top: 12px; flex-direction: row; }
.hud-button, .hud-button:hover {
    width: 44px; height: 44px; border-radius: 22px; margin: 0 12px 0 0; padding: 0;
    border-width: 2px; border-color: rgba(238, 241, 246, 0.3);
    background-color: rgba(18, 22, 30, 0.55);
    align-items: center; justify-content: center;
}
.hud-button:hover { background-color: rgba(18, 22, 30, 0.8); border-color: rgba(238, 241, 246, 0.5); }
.hud-button:active, .hud-button:hover:active, .hud-button.on { background-color: rgba(79, 140, 240, 0.8); border-color: rgba(238, 241, 246, 0.5); }
.hud.touch-input .hud-button { width: 52px; height: 52px; border-radius: 26px; margin-right: 14px; }
.hud-icon { width: 24px; height: 24px; -unity-background-scale-mode: scale-to-fit; }
.hud.touch-input .hud-icon { width: 28px; height: 28px; }
.hud-tip {
    display: none; position: absolute; left: -2px; top: 48px;
    flex-direction: row; align-items: center;
    /* A fixed height, as tall as with its key cap, so a tip without one (a gamepad's) doesn't come out shorter. */
    height: 25px; padding: 0 8px; font-size: 13px; white-space: nowrap;
    background-color: rgba(18, 22, 30, 0.88); border-radius: 3px;
}
.hud-button:hover .hud-tip { display: flex; }
.hud.touch-input .hud-tip { display: none; }
.hud-tip-key {
    margin-left: 8px; padding: 0 4px; font-size: 12px;
    border-width: 1px; border-color: rgba(238, 241, 246, 0.35); border-radius: 3px;
    -unity-font: url("Fonts/AtkinsonHyperlegibleMono-Regular.ttf");
}
/* A tip's key is the keyboard's (.keys-part) or the gamepad's (.pad-part, a rounded pill like the menu's); buttons
   with no gamepad binding show none on a pad. */
.hud-tip-pad { border-radius: 8px; padding: 0 6px; }

.name-tag {
    position: absolute; translate: -50% -100%;
    padding: 2px 8px; font-size: 13px;
    background-color: rgba(18, 22, 30, 0.75); border-radius: 3px;
}
.bubble {
    position: absolute; translate: -50% -100%;
    max-width: 220px; padding: 6px 11px;
    background-color: rgba(18, 22, 30, 0.88); border-radius: 6px;
}
.bubble > Label { font-size: 14px; white-space: normal; -unity-text-align: middle-center; }
.bubble-tail {
    position: absolute; left: 50%; bottom: -6px;
    width: 11px; height: 11px; margin-left: -6px;
    rotate: 45deg;
    background-color: rgba(18, 22, 30, 0.88);
}

/* Network stats (NetStats, F3): rows with a state dot. Numbers in the mono face so they don't jitter. */
.net-stats {
    position: absolute; left: 16px; top: 68px; width: 270px; /* under the HUD buttons */
    padding: 8px 10px 6px 10px; font-size: 13px;
    background-color: rgba(18, 22, 30, 0.78); border-radius: 4px;
}
.net-stats.hidden { display: none; }
.hud.touch-input .net-stats { top: 76px; } /* under the larger buttons */
/* The footer names F3, except with touch controls in use, where the stats button opens and closes the numbers. */
.touch-only, .hud.touch-input .keys-only { display: none; }
.hud.touch-input .touch-only { display: flex; }
.net-row { flex-direction: row; align-items: center; margin-bottom: 3px; }
.net-dot { width: 7px; height: 7px; border-radius: 4px; margin-right: 7px; flex-shrink: 0; background-color: rgb(92, 201, 138); }
.net-dot.warn { background-color: rgb(240, 181, 74); }
.net-dot.bad { background-color: rgb(240, 106, 94); }
.net-dot.none { background-color: rgba(0, 0, 0, 0); }
.net-row Label { padding: 0; margin: 0; }
.net-key { width: 78px; color: rgb(169, 178, 196); flex-shrink: 0; }
.net-num { -unity-font: url("Fonts/AtkinsonHyperlegibleMono-Regular.ttf"); }
.net-row .net-unit { margin-left: 4px; margin-right: 4px; color: rgb(169, 178, 196); }
.net-row .net-unit.tight { margin-left: 0; }
.net-dim { color: rgb(169, 178, 196); }
.net-foot {
    margin-top: 3px; padding: 4px 0 0 0;
    border-top-width: 1px; border-top-color: rgba(255, 255, 255, 0.12);
    font-size: 11px; color: rgb(141, 151, 171);
}

/* ---- Touch controls (phones): a floating stick on the left half, a camera drag on the right, and a jump button. ---- */
.touch { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.touch-half { position: absolute; top: 0; bottom: 0; width: 50%; }
.touch-left { left: 0; }
.touch-right { right: 0; }
.stick-base {
    position: absolute;
    width: 144px;
    height: 144px;
    border-radius: 72px;
    border-width: 3px;
    border-color: rgba(238, 241, 246, 0.35);
    background-color: rgba(18, 22, 30, 0.25);
    align-items: center;
    justify-content: center;
}
.stick-knob { width: 56px; height: 56px; border-radius: 28px; background-color: rgba(238, 241, 246, 0.6); }
/* Inside the screen's safe area (set from code, Hud), clear of notches and the home bar: Jump here, and the HUD
   buttons, chat box, stats and the rest of the overlay in .safe. */
.touch-safe, .safe { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
/* Sizes in panel pixels, which on a phone are about CSS pixels (Hud.PhoneReferenceResolution). */
.touch-button, .touch-button:hover {
    border-width: 2px;
    border-color: rgba(238, 241, 246, 0.3);
    background-color: rgba(18, 22, 30, 0.55);
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0;
}
.touch-button:active, .touch-button:hover:active, .touch-button.pressed { background-color: rgba(79, 140, 240, 0.8); }
.jump-button { position: absolute; right: 16px; bottom: 16px; width: 100px; height: 100px; border-radius: 50px; }
.touch-icon { width: 46px; height: 46px; -unity-background-scale-mode: scale-to-fit; }
.icon-look { background-image: url("Icons/look.png"); }
.icon-return { background-image: url("Icons/return.png"); }
.icon-chat { background-image: url("Icons/chat.png"); }
.icon-jump { background-image: url("Icons/jump.png"); }
.icon-stats { background-image: url("Icons/stats.png"); }
.icon-menu { background-image: url("Icons/menu.png"); }

/* ---- The Esc menu (Menu.uxml, GameMenu), ported from the approved mockup. ---- */

/* Parts for one kind of input: keys and mouse unless the HUD has .pad-input or .touch-input (TouchControls). */
.pad-part, .touch-part { display: none; }
.hud.pad-input .keys-part, .hud.touch-input .keys-part { display: none; }
.hud.pad-input .pad-part, .hud.touch-input .touch-part { display: flex; }

.key {
    min-width: 24px; padding: 1px 6px; margin: 0 2px;
    border-width: 1px; border-bottom-width: 2px; border-color: rgba(238, 241, 246, 0.4); border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.07);
    font-size: 12px; -unity-text-align: middle-center;
    -unity-font: url("Fonts/AtkinsonHyperlegibleMono-Regular.ttf");
}
.pad-word {
    padding: 1px 7px; border-width: 1px; border-color: rgba(238, 241, 246, 0.35); border-radius: 9px;
    font-size: 12px; -unity-font: url("Fonts/AtkinsonHyperlegibleMono-Regular.ttf");
}
.glyph { width: 26px; height: 26px; -unity-background-scale-mode: scale-to-fit; }
.glyph-label { margin-left: 2px; font-size: 11px; color: rgb(169, 178, 196); -unity-font: url("Fonts/AtkinsonHyperlegibleMono-Regular.ttf"); }
.icon-mouse-right { background-image: url("Icons/mouse_right.png"); }
.icon-stick { background-image: url("Icons/stick.png"); }
.icon-pad-south { background-image: url("Icons/pad_south.png"); }
.icon-pad-east { background-image: url("Icons/pad_east.png"); }

/* While the menu is open the game dims and the HUD fades behind it. */
/* The same for the look card changing the look (.look-open, set by Hud), whose dim is the card's own. */
.hud.menu-open .hud-row, .hud.menu-open .tags, .hud.menu-open .chat, .hud.menu-open .net-stats,
.hud.look-open .hud-row, .hud.look-open .tags { opacity: 0.35; }
.menu-host, .menu, .menu-dim, .menu-safe { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.menu-dim { background-color: rgba(8, 12, 22, 0.55); }

/* The list: a centered column of separate buttons, the selected one filled blue. */
.menu-list, .menu-confirm {
    position: absolute; left: 50%; top: 50%; translate: -50% -54%;
    align-items: stretch;
}
.menu-entry, .menu-entry:hover {
    width: 280px; height: 46px; padding: 0; margin: 0 0 6px 0;
    border-width: 2px; border-color: rgba(238, 241, 246, 0.12); border-radius: 6px;
    background-color: rgba(16, 20, 28, 0.82);
    color: rgb(238, 241, 246); font-size: 19px; -unity-text-align: middle-center;
}
.menu-entry:hover { border-color: rgba(238, 241, 246, 0.4); }
.menu-entry.leave { color: rgb(255, 160, 157); }
.menu-entry.leave:hover { border-color: rgba(255, 160, 157, 0.6); }
.menu.navigating .menu-entry.selected, .menu.navigating .menu-entry.selected:hover {
    background-color: rgb(61, 124, 240); border-color: rgba(255, 255, 255, 0.6);
    color: rgb(255, 255, 255); /* not bold: the entries would change width as the selection moves */
}
.menu.navigating .menu-entry.leave.selected, .menu.navigating .menu-entry.leave.selected:hover { background-color: rgb(190, 58, 54); }
/* Pressed: the button answers at once, before what it does. */
.menu-entry:active, .menu-entry:hover:active, .menu-back:active, .menu-back:hover:active, .menu-dev:active, .menu-dev:hover:active { background-color: rgba(79, 140, 240, 0.8); }
.menu-gap { height: 14px; }
.hud.phone .menu-entry { height: 38px; font-size: 17px; margin-bottom: 4px; }
.hud.phone .menu-gap { height: 8px; }

.menu-confirm { align-items: center; }
.menu-confirm-title { font-size: 22px; margin-bottom: 4px; -unity-font: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); }
.menu-confirm-note { font-size: 14px; color: rgb(169, 178, 196); margin-bottom: 16px; }

/* Controls and Settings: one fixed-size window for both pages and every device tab; long pages scroll inside. */
.menu-window {
    position: absolute; left: 50%; top: 50%; translate: -50% -54%;
    width: 600px; height: 440px; max-height: 76%;
    padding: 18px 24px 16px 24px;
    background-color: rgba(16, 20, 28, 0.96);
    border-width: 2px; border-color: rgba(238, 241, 246, 0.16); border-radius: 8px;
}
.menu-page-head { flex-direction: row; align-items: center; margin-bottom: 12px; flex-shrink: 0; }
.menu-back, .menu-back:hover {
    flex-direction: row; align-items: center;
    height: 28px; padding: 0 10px 0 8px; margin: 0 12px 0 0;
    border-width: 1px; border-color: rgba(255, 255, 255, 0.16); border-radius: 4px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(238, 241, 246); font-size: 13px;
}
.menu-back:hover { background-color: rgba(255, 255, 255, 0.06); }
.menu-back-arrow {
    width: 7px; height: 7px; margin-right: 6px; rotate: 45deg;
    border-left-width: 2px; border-bottom-width: 2px; border-color: rgb(238, 241, 246);
}
.menu-page-name { font-size: 20px; -unity-font: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); }

.menu-devices {
    flex-direction: row; align-items: flex-end; height: 36px; flex-shrink: 0; margin-bottom: 4px;
    border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.1);
}
.menu-dev, .menu-dev:hover {
    flex-direction: row; align-items: center;
    height: 30px; padding: 0 12px; margin: 0 4px 0 0;
    border-width: 0; border-bottom-width: 2px; border-color: rgba(0, 0, 0, 0); border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(169, 178, 196); font-size: 14px;
}
.menu-dev.on { color: rgb(238, 241, 246); border-bottom-color: rgb(106, 161, 255); }
.menu-in-use { display: none; margin-left: 6px; font-size: 11px; color: rgb(106, 161, 255); }
.menu-dev.current .menu-in-use { display: flex; }
.menu-shoulder {
    padding: 0 5px; margin: 0 6px 7px 6px; font-size: 11px; color: rgb(169, 178, 196);
    border-width: 1px; border-color: rgba(238, 241, 246, 0.35); border-radius: 4px;
    -unity-font: url("Fonts/AtkinsonHyperlegibleMono-Regular.ttf");
}

.menu-scroll { flex-grow: 1; }
.menu-scroll .unity-scroller--vertical { width: 6px; margin-left: 6px; border-width: 0; background-color: rgba(0, 0, 0, 0); }
.menu-scroll .unity-scroller__low-button, .menu-scroll .unity-scroller__high-button { display: none; }
.menu-scroll .unity-scroller__slider { width: 6px; min-width: 6px; margin: 0; padding: 0; flex-grow: 1; }
.menu-scroll .unity-base-slider__tracker {
    left: 0; right: 0; top: 0; bottom: 0; width: auto; margin: 0;
    border-width: 0; border-radius: 3px; background-color: rgba(255, 255, 255, 0.12);
}
.menu-scroll .unity-base-slider__dragger { left: 0; width: 6px; margin: 0; border-width: 0; border-radius: 3px; background-color: rgba(255, 255, 255, 0.35); }
.menu-scroll .unity-base-slider__dragger-border { display: none; }

/* One row style for both pages. */
.menu-row {
    flex-direction: row; align-items: center; justify-content: space-between;
    height: 42px; padding: 0 12px; flex-shrink: 0;
    border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.07);
}
.hud.phone .menu-row { height: 36px; }
.menu.navigating .menu-row.selected { background-color: rgba(106, 161, 255, 0.2); }
.menu-row-name { font-size: 15px; }
.menu-bind { flex-direction: row; align-items: center; }
.menu-bind-note { font-size: 13px; color: rgb(141, 151, 171); margin: 0 6px; }
.mini-button {
    width: 24px; height: 24px; border-radius: 12px; align-items: center; justify-content: center;
    border-width: 1px; border-color: rgba(238, 241, 246, 0.35); background-color: rgba(18, 22, 30, 0.55);
}
.mini-icon { width: 15px; height: 15px; -unity-background-scale-mode: scale-to-fit; }

.setting-text { flex-direction: row; align-items: flex-end; }
/* A section heading inside a page, in the join card's label style. */
.menu-section { margin: 14px 0 2px 12px; font-size: 12px; letter-spacing: 1px; color: rgb(169, 178, 196); }
.setting-note { margin-left: 10px; font-size: 12px; color: rgb(141, 151, 171); }
.switch { width: 44px; height: 24px; border-radius: 12px; flex-shrink: 0; background-color: rgb(61, 124, 240); }
.switch.off { background-color: rgba(255, 255, 255, 0.18); }
.switch-knob {
    position: absolute; top: 3px; left: 23px; width: 18px; height: 18px; border-radius: 9px;
    background-color: rgb(255, 255, 255);
    transition-property: left; transition-duration: 0.15s;
}
.switch.off .switch-knob { left: 3px; }
.slider { flex-direction: row; align-items: center; }
/* The track is taller than it looks, so it's easy to grab. */
.slider-track { width: 150px; height: 24px; justify-content: center; }
.slider-rail { position: absolute; left: 0; right: 0; top: 9px; height: 6px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.14); }
.slider-fill { position: absolute; left: 0; top: 9px; height: 6px; border-radius: 3px; background-color: rgb(106, 161, 255); }
.slider-knob { position: absolute; top: 3px; width: 18px; height: 18px; margin-left: -9px; border-radius: 9px; background-color: rgb(255, 255, 255); }
.slider-value {
    width: 46px; margin-left: 10px; font-size: 13px; color: rgb(169, 178, 196); -unity-text-align: middle-right;
    -unity-font: url("Fonts/AtkinsonHyperlegibleMono-Regular.ttf");
}

/* Button prompts along the bottom of the screen, for the input in use. */
.menu-prompts {
    position: absolute; left: 0; right: 0; bottom: 0; height: 40px; padding: 0 22px;
    flex-direction: row; justify-content: flex-end; align-items: center;
    background-color: rgba(8, 12, 22, 0.7); font-size: 14px;
}
.prompt { flex-direction: row; align-items: center; margin-left: 20px; }
.prompt .key, .prompt .glyph, .prompt .menu-shoulder { margin: 0 6px 0 0; }
.prompt .glyph { width: 22px; height: 22px; }
/* The device prompt only on the Controls page (.on-controls, set by GameMenu), still for the input in use. */
.hud .menu .prompt.tabs-prompt { display: none; }
.hud .menu.on-controls .prompt.tabs-prompt.keys-part { display: flex; }
.hud.pad-input .menu .prompt.tabs-prompt.keys-part, .hud.touch-input .menu .prompt.tabs-prompt.keys-part { display: none; }
.hud.pad-input .menu.on-controls .prompt.tabs-prompt.pad-part { display: flex; }

/* First time in the game: the menu button's tip stays up, outlined, until the menu is first opened (Hud). It names
   the key for the input in use (Start on a gamepad, none for touch). */
.hud-button.first-time .hud-tip, .hud.touch-input .hud-button.first-time .hud-tip {
    display: flex; border-width: 1px; border-color: rgb(106, 161, 255);
}
