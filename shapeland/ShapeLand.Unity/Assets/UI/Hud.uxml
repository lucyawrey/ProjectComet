<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Template name="Menu" src="Menu.uxml" />
    <Style src="ShapeLand.uss" />
    <ui:VisualElement name="hud" class="hud hidden" picking-mode="Ignore">
        <ui:VisualElement name="touch" class="touch hidden" picking-mode="Ignore">
            <ui:VisualElement name="touch-stick" class="touch-half touch-left">
                <ui:VisualElement name="stick-base" class="stick-base hidden" picking-mode="Ignore">
                    <ui:VisualElement name="stick-knob" class="stick-knob" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="touch-look" class="touch-half touch-right" />
            <ui:VisualElement name="touch-safe" class="touch-safe" picking-mode="Ignore">
                <ui:VisualElement name="jump-button" class="touch-button jump-button">
                    <ui:VisualElement class="touch-icon icon-jump" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="tags" class="tags" picking-mode="Ignore" />
        <ui:VisualElement name="safe" class="safe" picking-mode="Ignore">
            <ui:VisualElement name="chat" class="chat" picking-mode="Ignore">
                <ui:ScrollView name="log" class="chat-log empty" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
                <ui:VisualElement name="chat-input-row" class="chat-input-row hidden">
                    <ui:TextField name="chat-input" max-length="200" class="input chat-input" />
                    <ui:Button name="chat-send" text="#chat.send" class="chat-send" focusable="false" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="hud-buttons" class="hud-row" picking-mode="Ignore">
                <ui:Button name="menu-button" class="hud-button" focusable="false">
                    <ui:VisualElement class="hud-icon icon-menu" picking-mode="Ignore" />
                    <ui:VisualElement class="hud-tip" picking-mode="Ignore">
                        <ui:Label text="#hud.menu" picking-mode="Ignore" />
                        <ui:Label text="#hud.menu_key" class="key hud-tip-key keys-part" picking-mode="Ignore" />
                        <ui:Label text="#menu.pad_start" class="pad-word hud-tip-key pad-part" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="look-button" class="hud-button" focusable="false">
                    <ui:VisualElement class="hud-icon icon-look" picking-mode="Ignore" />
                    <ui:VisualElement class="hud-tip" picking-mode="Ignore">
                        <ui:Label text="#hud.change_look" picking-mode="Ignore" />
                        <ui:Label text="#hud.change_look_key" class="key hud-tip-key keys-part" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="return-button" class="hud-button" focusable="false">
                    <ui:VisualElement class="hud-icon icon-return" picking-mode="Ignore" />
                    <ui:VisualElement class="hud-tip" picking-mode="Ignore">
                        <ui:Label text="#hud.return_to_spawn" picking-mode="Ignore" />
                        <ui:Label text="#hud.return_to_spawn_key" class="key hud-tip-key keys-part" picking-mode="Ignore" />
                        <ui:Label text="#menu.pad_select" class="pad-word hud-tip-key pad-part" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="chat-button" class="hud-button" focusable="false">
                    <ui:VisualElement class="hud-icon icon-chat" picking-mode="Ignore" />
                    <ui:VisualElement class="hud-tip" picking-mode="Ignore">
                        <ui:Label text="#hud.chat" picking-mode="Ignore" />
                        <ui:Label text="#hud.chat_key" class="key hud-tip-key keys-part" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
            <ui:VisualElement name="net-stats" class="net-stats hidden" picking-mode="Ignore">
                <ui:VisualElement class="net-row" picking-mode="Ignore">
                    <ui:VisualElement name="ping-dot" class="net-dot" picking-mode="Ignore" />
                    <ui:Label text="#stats.ping" class="net-key" picking-mode="Ignore" />
                    <ui:Label name="ping" class="net-num" picking-mode="Ignore" />
                    <ui:Label text="#stats.ping_unit" class="net-unit" picking-mode="Ignore" />
                    <ui:Label name="ping-best" class="net-num net-dim" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="net-row" picking-mode="Ignore">
                    <ui:VisualElement name="delay-dot" class="net-dot" picking-mode="Ignore" />
                    <ui:Label text="#stats.delay" class="net-key" picking-mode="Ignore" />
                    <ui:Label name="delay" class="net-num" picking-mode="Ignore" />
                    <ui:Label text="#stats.delay_unit" class="net-unit" picking-mode="Ignore" />
                    <ui:Label name="delay-target" class="net-num net-dim" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="net-row" picking-mode="Ignore">
                    <ui:VisualElement name="holds-dot" class="net-dot" picking-mode="Ignore" />
                    <ui:Label text="#stats.holds" class="net-key" picking-mode="Ignore" />
                    <ui:Label name="holds" class="net-num" picking-mode="Ignore" />
                    <ui:Label text="#stats.holds_unit" class="net-unit tight" picking-mode="Ignore" />
                    <ui:Label name="held" class="net-num net-dim" picking-mode="Ignore" />
                    <ui:Label text="#stats.held_unit" class="net-unit" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="net-row" picking-mode="Ignore">
                    <ui:VisualElement name="snaps-dot" class="net-dot" picking-mode="Ignore" />
                    <ui:Label text="#stats.snap_backs" class="net-key" picking-mode="Ignore" />
                    <ui:Label name="snaps" class="net-num" picking-mode="Ignore" />
                    <ui:Label text="#stats.respawns_unit" class="net-unit" picking-mode="Ignore" />
                    <ui:Label name="respawns" class="net-num net-dim" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="net-row" picking-mode="Ignore">
                    <ui:VisualElement name="frame-dot" class="net-dot" picking-mode="Ignore" />
                    <ui:Label text="#stats.frame" class="net-key" picking-mode="Ignore" />
                    <ui:Label name="frame" class="net-num" picking-mode="Ignore" />
                    <ui:Label text="#stats.frame_unit" class="net-unit" picking-mode="Ignore" />
                    <ui:Label name="frame-worst" class="net-num net-dim" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="net-row" picking-mode="Ignore">
                    <ui:VisualElement class="net-dot none" picking-mode="Ignore" />
                    <ui:Label text="#stats.graphics" class="net-key" picking-mode="Ignore" />
                    <ui:Label name="graphics" class="net-unit" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label text="#stats.foot" class="net-foot keys-only" picking-mode="Ignore" />
                <ui:Label text="#stats.foot_touch" class="net-foot touch-only" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="Menu" name="menu-host" class="menu-host" picking-mode="Ignore" />
        <!-- Temporary account UI (the Account page and the guest reminder), to be reviewed and redone. -->
        <ui:Label name="guest-reminder" class="guest-reminder hidden" picking-mode="Ignore" />
        <ui:VisualElement name="account" class="menu-window account-window hidden">
            <ui:VisualElement class="menu-page-head">
                <ui:Button name="account-back" class="menu-back" focusable="false">
                    <ui:VisualElement class="menu-back-arrow" picking-mode="Ignore" />
                    <ui:Label text="#menu.back" picking-mode="Ignore" />
                </ui:Button>
                <ui:Label text="#account.page" class="menu-page-name" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:ScrollView class="menu-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                <ui:Label name="account-note" class="account-text" />
                <ui:VisualElement name="account-confirm-row" class="field hidden">
                    <ui:Label text="#account.current_password_label" class="label" />
                    <ui:TextField name="account-current" password="true" max-length="128" class="input" />
                    <ui:Button name="account-confirm" text="#account.confirm" class="account-button" />
                </ui:VisualElement>
                <ui:VisualElement class="field">
                    <ui:Label text="#account.new_password_label" class="label" />
                    <ui:TextField name="account-password" password="true" max-length="128" class="input" />
                    <ui:Button name="account-set-password" class="account-button" />
                </ui:VisualElement>
                <ui:VisualElement name="account-code-row" class="field">
                    <ui:Label text="#account.code_note" class="account-text" />
                    <ui:Button name="account-make-code" text="#account.make_code" class="account-button" />
                    <ui:Label name="account-code" class="account-code hidden" selectable="true" />
                    <ui:Button name="account-copy" text="#account.copy" class="account-button hidden" />
                </ui:VisualElement>
                <ui:Label name="account-status" class="account-text" />
                <ui:Label name="account-sign-out-warning" text="#account.sign_out_guest_warning" class="account-text hidden" />
                <ui:Button name="account-sign-out" text="#account.sign_out" class="account-button leave" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
