{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "StackBench": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Bench": {
    "TickRate": 30,
    "UpdatesPerTick": 10,
    "WarmupSeconds": 60,
    "DurationSeconds": 600,
    "ShutdownGraceSeconds": 30,
    "ResultsPath": "tools/StackBench/results/server.json"
  }
}
