root = true

[*]
indent_style = space
insert_final_newline = true

[*.{xml,csproj,props,targets,slnx,json}]
indent_size = 2

[*.cs]
indent_size = 4

# CSharpier owns layout.
dotnet_diagnostic.IDE0055.severity = none

# Usings
dotnet_sort_system_directives_first = true
dotnet_diagnostic.IDE0005.severity = warning
# IDE0005 needs a documentation file in the build. Doc comments stay optional, even for each parameter, but
# their references must resolve.
dotnet_diagnostic.CS1591.severity = none
dotnet_diagnostic.CS1573.severity = none
dotnet_diagnostic.CS1712.severity = none

# Style the code already follows
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
dotnet_diagnostic.IDE0007.severity = warning
csharp_style_namespace_declarations = file_scoped
dotnet_diagnostic.IDE0161.severity = warning
dotnet_style_readonly_field = true
dotnet_diagnostic.IDE0044.severity = warning

# Leftovers: unused private members and parameters
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning

# Naming
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_rule.interfaces.symbols = interfaces
dotnet_naming_rule.interfaces.style = i_pascal
dotnet_naming_rule.interfaces.severity = warning
dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal
dotnet_naming_rule.constants.severity = warning
dotnet_naming_rule.static_readonly_fields.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields.style = pascal
dotnet_naming_rule.static_readonly_fields.severity = warning
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_rule.locals_and_parameters.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters.style = camel
dotnet_naming_rule.locals_and_parameters.severity = warning
dotnet_naming_rule.everything_else.symbols = everything_else
dotnet_naming_rule.everything_else.style = pascal
dotnet_naming_rule.everything_else.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter
dotnet_naming_symbols.everything_else.applicable_kinds = namespace, class, struct, enum, property, method, event, delegate, field, local_function, type_parameter

dotnet_naming_style.i_pascal.required_prefix = I
dotnet_naming_style.i_pascal.capitalization = pascal_case
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.camel.capitalization = camel_case
dotnet_naming_style.pascal.capitalization = pascal_case

# Analyzers (AnalysisMode Recommended), with the rules that don't fit turned off
# MessagePack and Unity serialize public fields.
dotnet_diagnostic.CA1051.severity = none
# Log calls are off the hot paths; LoggerMessage methods would add code for no measured gain.
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# The shared packages also build for netstandard2.1 (Unity), which lacks the APIs these suggest.
dotnet_diagnostic.CA1512.severity = none
dotnet_diagnostic.CA1850.severity = none
dotnet_diagnostic.CA1872.severity = none
dotnet_diagnostic.CA2263.severity = none
# The flagged calls format or parse integers and messages, not data shared between machines.
dotnet_diagnostic.CA1305.severity = none
# Visual Basic keywords (Error, Shared) and type name suffixes (Queue, Collection) that are the right names here.
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1711.severity = none
# Static factories on generic result types read well.
dotnet_diagnostic.CA1000.severity = none
# Performance rewrites that cost readability off the hot paths.
dotnet_diagnostic.CA1845.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1861.severity = none

[{comet,shapeland}/tests/**.cs]
# Test classes are made and dropped per test, and the WebSocket handshake needs SHA-1.
dotnet_diagnostic.CA1001.severity = none
dotnet_diagnostic.CA1816.severity = none
dotnet_diagnostic.CA5350.severity = none
# Helpers stay members of the test client they belong to.
dotnet_diagnostic.CA1822.severity = none

[tools/**.cs]
# File-based apps have no namespace, and their top-level constants are settings, named like fields.
dotnet_diagnostic.CA1050.severity = none
dotnet_naming_symbols.constants.applicable_kinds = field, local

[**/Migrations/**]
generated_code = true
